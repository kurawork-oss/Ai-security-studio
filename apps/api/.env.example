# ─── SecureAI Studio API 環境変数（値はダミー。本番はシークレットマネージャで管理）───
# すべて起動時に検証されます（core/config.py）。ハードコード禁止。

# App
SECUREAI_ENVIRONMENT=development
SECUREAI_LOG_LEVEL=info
SECUREAI_API_TEXT_MAX_BYTES=102400

# CORS（Dashboard オリジン。カンマ区切り）
SECUREAI_CORS_ORIGINS=http://localhost:3000

# 既定プロバイダー（MVP: gemini。dev では echo で外部呼び出しなしに動作確認可能）
SECUREAI_DEFAULT_PROVIDER=gemini
SECUREAI_GEMINI_API_BASE=https://generativelanguage.googleapis.com
SECUREAI_GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# 暗号化（Provider API Key の AES-256-GCM / KeyProvider）
SECUREAI_KMS_PROVIDER=env
# 32 バイト以上の秘密（本番は KMS 管理）。dev 用ダミー:
SECUREAI_ENCRYPTION_KEK=dev-only-change-me-0123456789abcdef0123456789abcdef

# ─── 開発用シード（本番では false）───
# true の場合、メモリ上に dev プロジェクト/プロバイダー/APIキーを投入して即動作確認できる
SECUREAI_DEV_SEED=true
# dev シードで発行される固定 API キー（本番では絶対に使わない）
SECUREAI_DEV_PROTECT_KEY=sk_protect_dev_0000000000000000
SECUREAI_DEV_ANALYZE_KEY=sk_analyze_dev_0000000000000000
# dev プロバイダー（echo なら Gemini キー不要で Analyze を試せる）
SECUREAI_DEV_PROVIDER_TYPE=echo
SECUREAI_DEV_GEMINI_KEY=

# ─── Postgres / Supabase（設定すると in-memory ではなく DB を使用）───
# 未設定なら DEV_SEED のメモリ動作。設定すると管理 API + 永続化が有効。
# SECUREAI_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/secureai
# 管理 API（Control Plane）の Supabase JWT 検証（HS256）
# SECUREAI_SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SECUREAI_SUPABASE_JWT_AUDIENCE=authenticated
