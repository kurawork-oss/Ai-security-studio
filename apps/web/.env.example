# SecureAI Studio — Web (.env.local)

# ── API (server-side; never exposed to the browser) ──
SECUREAI_API_BASE_URL=http://localhost:8000
# Playground BFF (data plane) keys:
SECUREAI_PROTECT_KEY=sk_protect_dev_0000000000000000
SECUREAI_ANALYZE_KEY=sk_analyze_dev_0000000000000000
# Management BFF: dev fallback JWT used when there is no Supabase session
# (mint one with SECUREAI_SUPABASE_JWT_SECRET). Leave empty in production.
SECUREAI_DEV_JWT=

# ── Public (browser) — Supabase Auth for the dashboard ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
